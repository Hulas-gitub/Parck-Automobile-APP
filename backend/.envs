# ===================================
# APPLICATION CONFIGURATION
# ===================================
APP_NAME="Fleetify SGS"
APP_ENV=local
APP_KEY=base64:z/2UvxsNAa+WW/VciBaSKLXF0/lUlotJyhWcDvVzJvI=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Libreville
APP_FRONTEND_URL=http://localhost:5173
# Localization
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
DEBUGBAR_ENABLED=false
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ===================================
# FRONTEND & CORS
# ===================================
FRONTEND_URL=http://localhost:5173

# ===================================
# LOGGING
# ===================================
LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleetify_db
DB_USERNAME=root
DB_PASSWORD=

# ===================================
# SESSION & CACHE (OPTIMISÉ POUR SANCTUM API)
# ===================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=fleetify_cache

# ===================================
# SANCTUM CONFIGURATION (SIMPLIFIÉ POUR API)
# ===================================
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_PREFIX=

# ===================================
# QUEUE CONFIGURATION
# ===================================
QUEUE_CONNECTION=database

# ===================================
# BROADCAST & FILESYSTEM
# ===================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ===================================
# MAIL CONFIGURATION (PRODUCTION SGS)
# ===================================
MAIL_MAILER=smtp
MAIL_HOST=mail.sgs-gabon.com
MAIL_PORT=587
MAIL_USERNAME=noreply@sgs-gabon.com
MAIL_PASSWORD=Gasgs@2024
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@sgs-gabon.com"
MAIL_FROM_NAME="noreply@sgs-gabon.com"
# ===================================
# REDIS (optionnel)
# ===================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===================================
# MEMCACHED (optionnel)
# ===================================
MEMCACHED_HOST=127.0.0.1

# ===================================
# AWS S3 (pour stockage fichiers cloud)
# ===================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===================================
# FLEETIFY SPECIFIC SETTINGS
# ===================================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_IN_APP_ENABLED=true

ALERTE_KM_VIDANGE_SEUIL=500
ALERTE_KM_REVISION_SEUIL=1000
ALERTE_JOURS_EXPIRATION_ASSURANCE=60
ALERTE_JOURS_EXPIRATION_VISITE=30
ALERTE_JOURS_EXPIRATION_PERMIS=60

ALERTE_STOCK_CRITIQUE_POURCENTAGE=10

PAGINATION_PER_PAGE=15

MAX_UPLOAD_SIZE=10240
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

APP_URL=http://localhost/Fleetify_management_autoparck/Fleetify_management_autoparck/backend/public
FILESYSTEM_DISK=public
